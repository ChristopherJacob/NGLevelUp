# Copy to secrets.yaml (which is gitignored) and fill in.
#
# Names are qualified deliberately. A bare `wifi_ssid` is ambiguous when the
# same config is built on more than one host — on the van's Home Assistant that
# name already meant the van's own network, so building this config there would
# have collided with an existing device. Explicit names let the identical file
# build unchanged anywhere.

house_wifi_ssid: "YourHouseSSID"
house_wifi_password: "..."

# NOTE: 2.4 GHz only. The ESP32-S3 radio is 802.11 b/g/n and cannot see a 5 GHz
# SSID at all, so pointing this at a 5 GHz network guarantees it never connects.
van_wifi_ssid: "YourVan-2.4"
van_wifi_password: "..."

# Fallback access point, used if no known network is reachable.
ap_password: "..."

# Home Assistant API encryption. Generate with:
#   openssl rand -base64 32
cores3_gnss__encryption_key: "base64-32-bytes"
